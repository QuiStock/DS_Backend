DB_URL=jdbc:postgresql://localhost:5432/quistock
DB_USERNAME=postgres
DB_PASSWORD=change-me
AUTH_JWT_ISSUER=http://localhost:8090
AUTH_JWT_JWK_SET_URI=http://localhost:8090/.well-known/jwks.json
AUTH_JWT_AUDIENCE=quistock-api
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ERP_API_BASE_URL=http://localhost:8091
ERP_API_PRODUCTS_PATH=/products
ERP_SYNC_ENABLED=true
ERP_SYNC_FIXED_DELAY_MS=900000
ERP_SYNC_INITIAL_DELAY_MS=1000

SERVER_PORT=8080
# Optional migration override; empty means root
SERVER_SERVLET_CONTEXT_PATH=

HEALTH_TIMEOUT_MS=4000
HEALTH_CACHE_TTL=5s
# Budget these values across all replicas and clients sharing the database.
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=0
# Set false only when ERP is intentionally unnecessary for this deployment.
HEALTH_ERP_REQUIRED=true
